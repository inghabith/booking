# Supabase o Postgres local. Acepta postgresql:// (se convierte a postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/booking_platform

# Contratos síncronos (REST) con otros servicios
USERS_SERVICE_URL=http://localhost:8001
RESOURCES_SERVICE_URL=http://localhost:8002

# Eventos: "logging" (solo imprime) o "rabbitmq"
EVENT_PUBLISHER=logging
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
